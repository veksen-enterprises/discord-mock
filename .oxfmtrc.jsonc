{
  "printWidth": 80,
  "arrowParens": "always",
  "bracketSpacing": true,
  "endOfLine": "lf",
  "semi": true,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "all",
  "useTabs": false,
  "sortImports": {
    "groups": ["builtin", "external", "internal", "parent", "sibling", "index"],
    "newlinesBetween": false,
    "order": "asc",
    "ignoreCase": true,
  },
}
